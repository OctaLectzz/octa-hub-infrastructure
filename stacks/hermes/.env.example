# Hermes Dashboard
# Use Nous OAuth for a public-facing dashboard.
# Register the OAuth client with:
# hermes dashboard register --redirect-uri https://hermes.octalectzz.my.id/auth/callback
HERMES_DASHBOARD=1
HERMES_DASHBOARD_HOST=0.0.0.0
HERMES_DASHBOARD_PORT=9119
HERMES_DASHBOARD_OAUTH_CLIENT_ID=replace-with-client-id-from-hermes-dashboard-register
HERMES_DASHBOARD_PUBLIC_URL=https://hermes.octalectzz.my.id

# Optional Basic Auth provider.
# Official guidance: trusted networks/VPN only; not recommended for public-internet exposure.
# Uncomment and replace with unique values only if appropriate for your deployment.
# HERMES_DASHBOARD_BASIC_AUTH_USERNAME=replace-with-username
# HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=replace-with-strong-password
# HERMES_DASHBOARD_BASIC_AUTH_SECRET=replace-with-random-secret

# Do not put API_SERVER_KEY or model-provider API keys in this template.
# Keep runtime credentials in the protected Hermes data configuration.
